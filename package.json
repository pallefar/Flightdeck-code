{
  "name": "flightdeck-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prompt-to-mini-app builder for Flightdeck OS",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build:designer": "node designer-source/build.mjs",
    "check:designer": "node designer-source/build.mjs --check",
    "test:designer": "node designer-source/tests/run.mjs",
    "build": "node designer-source/build.mjs && tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-all.mjs",
    "test:vitest": "vitest run",
    "test:docker": "node --test deploy/studio-docker/*.test.mjs",
    "studio:first-test": "node scripts/studio-first-test.mjs",
    "verify:openharness": "python3 -B scripts/verify-openharness.py",
    "lint": "eslint .",
    "redteam": "tsx scripts/redteam-gate.ts",
    "mount": "bash scripts/mount-in-host.sh",
    "promote": "bash scripts/promote.sh",
    "standalone": "bash scripts/standalone-smoke.sh",
    "prebuild": "npm --prefix packages/studio-drafts run build",
    "pretypecheck": "npm --prefix packages/studio-drafts run build",
    "pretest": "npm --prefix packages/studio-drafts run build",
    "pretest:vitest": "npm --prefix packages/studio-drafts run build",
    "predev": "npm --prefix packages/studio-drafts run build",
    "predev:server": "npm --prefix packages/studio-drafts run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "fastify": "^5.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1",
    "tsx": "4.23.15",
    "@flightdeck/studio-drafts-source": "file:packages/studio-drafts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "4.1.11"
  }
}
