{
  "name": "flightdeck-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prompt-to-mini-app builder for Flightdeck OS",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "redteam": "tsx scripts/redteam-gate.ts",
    "mount": "bash scripts/mount-in-host.sh",
    "promote": "bash scripts/promote.sh",
    "standalone": "bash scripts/standalone-smoke.sh",
    "responsive": "node scripts/responsive-smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "animejs": "^4.5.0",
    "fastify": "^5.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
