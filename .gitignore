# dependencies — no trailing slash: worktrees share one install through a
# node_modules SYMLINK, and `node_modules/` only matches directories.
node_modules

# build output
dist/
build/
*.tsbuildinfo

# test / coverage
coverage/
.vitest/

# local env — never commit keys
.env
.env.local
.env.*.local

# editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# gauntlet scratch: neutral A/B judging dirs and round artifacts
.gauntlet/

# builder scratch: throwaway probes and virtual-FS roots used while prototyping
.fd-probe/
.fd-virtual/
**/__tests__/tmp/
.studio/
