{
  "name": "@flightdeck/studio-drafts-source",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "zod": "3.25.76"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "exports": {
    "./browser": {
      "types": "./dist/browser/client.d.ts",
      "default": "./dist/browser/client.js"
    },
    "./context-ui": {
      "types": "./dist/browser/context-ui.d.ts",
      "default": "./dist/browser/context-ui.js"
    },
